# Copy this file to .env and add your own values.
# Never commit the real .env file.

# Required: SerpApi API key used to retrieve Amazon.sa product data
SERPAPI_KEY=your_serpapi_key_here

# Request timeout in seconds
REQUEST_TIMEOUT=15

# Amazon marketplace / response defaults
AMAZON_BASE_URL=https://www.amazon.sa
DEFAULT_CURRENCY=SAR
SOURCE_NAME=Amazon.sa

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
